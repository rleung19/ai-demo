# Oracle Autonomous Database Serverless Configuration
# Copy this file to .env and fill in your actual values

# ADB Connection - Wallet Path
# Path to the directory containing your ADB wallet files
# Example: /path/to/wallet or ./wallet
ADB_WALLET_PATH=

# ADB Connection String
# RECOMMENDED: Use TNS alias from tnsnames.ora (simple format)
# Example: hhzj2h81ddjwn1dm_high
# 
# Alternative formats:
# - TNS alias: hhzj2h81ddjwn1dm_high (recommended, works with thin/thick mode)
# - Host:Port/Service: adb.us-chicago-1.oraclecloud.com:1522/service_name (thin mode)
# - Full TNS description: (description=...) (thick mode only, not recommended)
ADB_CONNECTION_STRING=

# ADB Credentials
# Username for OML schema (typically "OML" or your schema name)
ADB_USERNAME=OML
# Password for the OML schema
# IMPORTANT: If password contains special characters (#, $, !, etc.), use quotes:
# ADB_PASSWORD="YourPassword#123"
ADB_PASSWORD=

# Optional: TNS Admin (usually same as wallet path)
# If not set, will use ADB_WALLET_PATH
TNS_ADMIN=

# API Configuration
# Port for Express churn API (default: 3001 in code when API_PORT=3001)
API_PORT=3000

# Churn KPI API target for the Next.js UI (Express-only)
# Unset → http://localhost:3001 (local dev)
# Set to public Express URL in production
# NEXT_PUBLIC_API_URL=http://localhost:3001
# NEXT_PUBLIC_API_URL=https://ecomm-api.example.com

# Environment
NODE_ENV=development

# OCI Model Deployment Endpoints
# OCI Data Science model deployment endpoints for recommender models
# These endpoints are obtained from your OCI Data Science Notebook deployment cells
# Format: https://modeldeployment.{region}.oci.customer-oci.com/ocid1.datasciencemodeldeployment.oc1.{region}.{id}
# Do NOT include the /predict suffix - it will be added automatically
OCI_PRODUCT_RECOMMENDER_MODEL_ENDPOINT=
OCI_BASKET_RECOMMENDER_MODEL_ENDPOINT=

# Agentic AI Flow Webhook (VIP re-engagement and future campaigns)
# Public/accessible URL for the n8n (or other orchestration) webhook that
# receives the agentic flow payload:
# {
#   "cohort": "VIP",
#   "users": [{ "userId": "...", "churnProbability": 0.72, "ltv": 8452.50 }]
# }
# - In local dev, you can point this to a test n8n instance or mock server.
# - In production (OCI), this will be configured via .env.oci.
NEXT_PUBLIC_AGENTIC_FLOW_WEBHOOK_URL=***REMEMBER_TO_SET_WEBHOOK_URL***

# PostgreSQL (OCI — feature/postgres-backend)
# DB_BACKEND=postgres uses pg + DATABASE_URL; default oracle uses ADB wallet
DB_BACKEND=oracle
# Reach private IP 10.0.1.239 via SSH tunnel: scripts/dev/pg-tunnel.sh
# Local tunnel maps 127.0.0.1:15432 → 10.0.1.239:5432 through jump host 40b5c371.nip.io
PGHOST=127.0.0.1
PGPORT=15432
PGUSER=
PGPASSWORD=
PGDATABASE=
# node pg client needs TLS for OCI Postgres through tunnel (psycopg2 may work without)
# PGSSLMODE=disable
# Preferred single connection string (quote if password has special characters):
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:15432/DATABASE?sslmode=require
DATABASE_URL=

# Optional: keg-only Homebrew psql path
# PSQL_PATH=/opt/homebrew/opt/libpq/bin/psql

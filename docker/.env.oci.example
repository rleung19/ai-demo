# OCI VM runtime config — copy to docker/.env.oci (not committed)
#
# Build-time (embedded in Next.js bundle — must export before `docker compose build`):
#   NEXT_PUBLIC_API_URL
#   NEXT_PUBLIC_AGENTIC_FLOW_WEBHOOK_URL
#
# deploy.sh exports NEXT_PUBLIC_* automatically from this file.

NODE_ENV=production

# Public Express API URL (browser calls this for churn KPIs)
NEXT_PUBLIC_API_URL=https://ecomm-api.40b5c371.nip.io

# Optional: VIP agentic flow webhook (Proceed button hidden if unset)
NEXT_PUBLIC_AGENTIC_FLOW_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Database backend: oracle | postgres
# ---------------------------------------------------------------------------
DB_BACKEND=oracle

# --- Oracle ADB (when DB_BACKEND=oracle) ---
# Wallet is mounted at /opt/oracle/wallet via docker-compose.oracle.yml
ADB_WALLET_PATH=/opt/oracle/wallet
TNS_ADMIN=/opt/oracle/wallet
ADB_CONNECTION_STRING=hhzj2h81ddjwn1dm_medium
ADB_USERNAME=OML
ADB_PASSWORD=

# --- PostgreSQL (when DB_BACKEND=postgres) ---
# Use private VCN IP from the OCI Postgres instance (no SSH tunnel in production)
# DB_BACKEND=postgres
# PGHOST=10.0.1.239
# PGPORT=5432
# PGUSER=ecomm
# PGPASSWORD=
# PGDATABASE=ecommdb
# PGSSLMODE=require
# Or single URL (quote password if it contains special characters):
# DATABASE_URL=postgresql://ecomm:PASSWORD@10.0.1.239:5432/ecommdb?sslmode=require

# ---------------------------------------------------------------------------
# OCI Model Deployment endpoints (recommender APIs)
# ---------------------------------------------------------------------------
OCI_PRODUCT_RECOMMENDER_MODEL_ENDPOINT=
OCI_BASKET_RECOMMENDER_MODEL_ENDPOINT=

# Express listens on 3001 inside the container (mapped to host 3003)
API_PORT=3001
